# Barber's Shop Environment Variables

# GEMINI_API_KEY: Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Authentication Secret (Used for HMAC signing of session tokens)
JWT_SECRET="barbershop-luxury-craft-jwt-secret-key-production-change-me"

# Persistent SQLite Database Path (Defaults to ./data/barbershop.db)
DATABASE_PATH="./data/barbershop.db"

# Optional Supabase Integration (PostgreSQL Database & Auth)
# If configured, the app can sync or direct queries to Supabase
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Transactional Email Integration (e.g. Resend, SendGrid)
RESEND_API_KEY=""
EMAIL_FROM="appointments@barbershop.local"
